<?xml version="1.0" encoding="utf-8"?>
<!-- The first frame the process draws. Matching the app canvas exactly means the switch to
     Compose is invisible instead of a white flash on a dark app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#07070A" />
        </shape>
    </item>
</layer-list>
